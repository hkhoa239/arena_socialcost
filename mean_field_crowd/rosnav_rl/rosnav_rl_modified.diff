+@RewardUnitFactory.register("pedestrian_proximity")
+class RewardPedestrianProximity(RewardUnit):
+    """Penalty from the nearest pedestrian's current position.
+
+    No velocity and no forecast. The charge is ``factor * (margin - distance)``
+    while the nearest person is inside ``margin``, and zero otherwise.
+    """
+
+    requires = {
+        "pedestrian_relative_locations": PedestrianRelativeLocations,
+    }
+
+    @check_params
+    def __init__(
+        self,
+        reward_function: RewardFunction,
+        margin: float = 1.0,
+        factor: float = -0.5,
+        _on_safe_dist_violation: bool = True,
+        *args: Any,
+        **kwargs: Any,
+    ) -> None:
+        super().__init__(reward_function, _on_safe_dist_violation, *args, **kwargs)
+        self._margin = margin
+        self._factor = factor
+
+    def check_parameters(self) -> None:
+        if self._margin <= 0.0:
+            self._report_error(f"margin must be positive, got {self._margin}")
+        if self._factor > 0.0:
+            self._report_warning(f"A positive factor rewards standing near a pedestrian. Current value: {self._factor}")
+
+    def __call__(
+        self,
+        pedestrian_relative_locations: PedestrianRelativeLocations,
+        *args: Any,
+        **kwargs: Any,
+    ) -> None:
+        if pedestrian_relative_locations is None or len(pedestrian_relative_locations) == 0:
+            return
+        positions = np.asarray(pedestrian_relative_locations, dtype=np.float64).reshape(-1, 2)
+        distance = float(np.linalg.norm(positions, axis=1).min())
+        intrusion = self._margin - distance
+        if intrusion > 0.0:
+            self.add_reward(self._factor * intrusion)
+
+
+@RewardUnitFactory.register("pedestrian_forecast_proximity")
+class RewardPedestrianForecastProximity(RewardUnit):
+    """Penalty on where the nearest pedestrian will be if the current velocity holds.
+
+    The predicted point is the current robot-frame position plus the current
+    robot-frame velocity times ``horizon``. No residual network and no model
+    of the robot's own future motion.
+    """
+
+    requires = {
+        "pedestrian_relative_locations": PedestrianRelativeLocations,
+        "pedestrian_relative_velocities": PedestrianRelativeVelocities,
+    }
+
+    @check_params
+    def __init__(
+        self,
+        reward_function: RewardFunction,
+        margin: float = 1.0,
+        factor: float = -0.5,
+        horizon: float = 1.0,
+        _on_safe_dist_violation: bool = True,
+        *args: Any,
+        **kwargs: Any,
+    ) -> None:
+        super().__init__(reward_function, _on_safe_dist_violation, *args, **kwargs)
+        self._margin = margin
+        self._factor = factor
+        self._horizon = horizon
+
+    def check_parameters(self) -> None:
+        if self._margin <= 0.0 or self._horizon <= 0.0:
+            self._report_error(f"margin and horizon must be positive, got {self._margin}, {self._horizon}")
+        if self._factor > 0.0:
+            self._report_warning(f"A positive factor rewards a pedestrian entering the margin. Current value: {self._factor}")
+
+    def __call__(
+        self,
+        pedestrian_relative_locations: PedestrianRelativeLocations,
+        pedestrian_relative_velocities: PedestrianRelativeVelocities,
+        *args: Any,
+        **kwargs: Any,
+    ) -> None:
+        if pedestrian_relative_locations is None or len(pedestrian_relative_locations) == 0:
+            return
+        positions = np.asarray(pedestrian_relative_locations, dtype=np.float64).reshape(-1, 2)
+        velocities = np.asarray(pedestrian_relative_velocities, dtype=np.float64).reshape(-1, 2)
+        count = min(len(positions), len(velocities))
+        if count == 0:
+            return
+        future = positions[:count] + velocities[:count] * self._horizon
+        distance = float(np.linalg.norm(future, axis=1).min())
+        intrusion = self._margin - distance
+        if intrusion > 0.0:
+            self.add_reward(self._factor * intrusion)
+
+
