+def _constructor_names(algorithm_class: type) -> set[str]:
+    """Names a constructor accepts, including parameters inherited through ``**kwargs``."""
+    names: set[str] = set()
+    for parent in inspect.getmro(algorithm_class):
+        if parent is object:
+            continue
+        try:
+            parameters = inspect.signature(parent.__init__).parameters
+        except (TypeError, ValueError):
+            continue
+        names.update(
+            name
+            for name, parameter in parameters.items()
+            if name != "self" and parameter.kind not in (inspect.Parameter.VAR_POSITIONAL, inspect.Parameter.VAR_KEYWORD)
+        )
+    return names
