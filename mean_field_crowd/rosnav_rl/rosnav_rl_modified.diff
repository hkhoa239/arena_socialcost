+class EpisodeMixtureCurriculum(CurriculumBase, BaseCallback):
+    """Samples every env's next episode from the curriculum stages with fixed weights.
+
+    When env i finishes an episode, a stage drawn from `weights` with env i's own seeded
+    generator is sent to env i's task generator only. The vec env has already reset env i
+    by then, so the drawn stage runs one episode later; every episode is still an
+    independent draw. `[MIXTURE]` lines record which stage each started episode used.
+    """
+
+    def __init__(
+        self,
+        node: Node,
+        train_stages: StageInput,
+        weights: list[float],
+        seed: int,
+        num_envs: int,
+        parameter_node_template: str,
+        timeout: float = 5.0,
+        verbose: int = 0,
+        tm_dict: dict[str, Any] | None = None,
+    ):
+        import numpy as np
+
+        CurriculumBase.__init__(
+            self,
+            node=node,
+            train_stages=train_stages,
+            threshold_type="succ",
+            upper_threshold=float("inf"),
+            lower_threshold=float("-inf"),
+            num_envs=num_envs,
+            parameter_node_template=parameter_node_template,
+            timeout=timeout,
+            starting_stage=0,
+            verbose=0,
+            tm_dict=tm_dict,
+        )
+        BaseCallback.__init__(self, verbose=verbose)
+        if len(weights) != self.max_index or any(w < 0 for w in weights) or sum(weights) <= 0:
+            raise ValueError(f"mixture_weights needs one non-negative weight per stage ({self.max_index}), got {weights}")
+        total = float(sum(weights))
+        self.weights = np.asarray([w / total for w in weights], dtype=np.float64)
+        self.rngs = [np.random.default_rng([int(seed), i]) for i in range(num_envs)]
+        self.node_names = list(self.parameter_clients.keys())
+        # Stage queued on the env's task generator, and the stage of the episode it is running.
+        self.queued: list[int] = [0] * num_envs
+        self.running: list[int] = [0] * num_envs
+        self.started = [[0] * self.max_index for _ in range(num_envs)]
+
+    def get_current_performance(self) -> float | None:
+        return None
+
+    def reset_performance_tracking(self) -> None:
+        pass
+
+    def _draw(self, env: int) -> int:
+        stage = int(self.rngs[env].choice(len(self.weights), p=self.weights))
+        params = {k: v for k, v in self._stages[stage].items() if k not in self._TASK_MODE_KEYS and k != "train_mode"}
+        if not self._set_parameters_batch(self.node_names[env], params):
+            print(f"[MIXTURE] env {env}: failed to queue stage {stage}", flush=True)
+        return stage
+
+    def _on_training_start(self) -> None:
+        # The first episodes started before training; queue a draw for each env's next episode.
+        for env in range(len(self.rngs)):
+            self.queued[env] = self._draw(env)
+        print(f"[MIXTURE] weights {self.weights.round(3).tolist()} over {self.max_index} stages", flush=True)
+
+    def _on_step(self) -> bool:
+        dones = self.locals.get("dones")
+        if dones is None:
+            return True
+        for env, done in enumerate(dones):
+            if not done:
+                continue
+            self.running[env] = self.queued[env]
+            self.started[env][self.running[env]] += 1
+            print(f"[MIXTURE] env {env} started stage {self.running[env]} at step {self.num_timesteps}", flush=True)
+            self.queued[env] = self._draw(env)
+        return True
+
+
+class ActionStatsCallback(BaseCallback):
+    """Per rollout: how often PPO's Gaussian samples were clipped by the action box, the executed
+    linear and angular commands, the reverse-driving fraction, GPU memory, and wall-clock rate.
+
+    SB3 stores the unclipped sample and its log-probability and sends the clipped copy to the
+    env, so the clip rate is the size of the sample/execution mismatch."""
+
+    def __init__(self, decode, verbose: int = 0):
+        super().__init__(verbose=verbose)
+        self.decode = decode
+        self._started = None
+
+    def _on_rollout_start(self) -> None:
+        import time
+
+        self._started = time.perf_counter()
+        self._steps_at_start = self.num_timesteps
+
+    def _on_step(self) -> bool:
+        return True
+
+    def _on_rollout_end(self) -> None:
+        import time
+
+        import numpy as np
+
+        actions = np.asarray(self.model.rollout_buffer.actions).reshape(-1, self.model.action_space.shape[0])
+        low, high = self.model.action_space.low, self.model.action_space.high
+        clipped = np.clip(actions, low, high)
+        executed = np.stack([self.decode(a) for a in clipped])
+        v, w = executed[:, 0], executed[:, -1]
+        log = self.logger.record
+        for dim in range(actions.shape[1]):
+            log(f"action/clip_rate_{dim}", float(np.mean((actions[:, dim] < low[dim]) | (actions[:, dim] > high[dim]))))
+        log("action/v_mean", float(v.mean()))
+        log("action/v_p10", float(np.percentile(v, 10)))
+        log("action/v_p90", float(np.percentile(v, 90)))
+        log("action/abs_w_mean", float(np.abs(w).mean()))
+        log("action/reverse_frac", float(np.mean(v < -0.05)))
+        log("action/stop_frac", float(np.mean(np.abs(v) <= 0.05)))
+        if self._started is not None:
+            elapsed = time.perf_counter() - self._started
+            log("time/rollout_env_fps", float((self.num_timesteps - self._steps_at_start) / max(elapsed, 1e-6)))
+        try:
+            import torch
+
+            if torch.cuda.is_available():
+                log("time/gpu_max_mem_mib", float(torch.cuda.max_memory_allocated() / 2**20))
+        except Exception:
+            pass
