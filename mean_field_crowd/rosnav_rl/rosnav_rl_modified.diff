+    def test_speed_scaled_lookahead_does_not_pay_for_closing_on_the_goal(self, make_reward_function):
+        """A constant 0.5 m/s command holds the lookahead at 0.75 m, so the subgoal distance never falls.
+
+        The same cruise reduces distance to the final goal. The pilot coefficients are pos 0.3 and neg 0.4.
+        Raising speed from 0.4 to 0.5 m/s lengthens the lookahead and is charged as a retreat, while the
+        robot has moved toward the goal.
+        """
+        from rosnav_rl.observations.utils.semantic import straight_line_subgoal
+
+        goal = (12.0, 0.0)
+        speed = 0.5
+        positions = [index * 0.05 for index in range(41)]
+
+        def in_robot_frame(x: float, point: tuple[float, float]) -> np.ndarray:
+            return np.array([point[0] - x, point[1]], dtype=np.float64)
+
+        def drive(follow_subgoal: bool, speeds: list[float]) -> float:
+            rf = make_reward_function()
+            unit = RewardApproachGoal(
+                rf,
+                pos_factor=0.3,
+                neg_factor=0.4,
+                _goal_update_threshold=0.25,
+                _follow_subgoal=follow_subgoal,
+            )
+            for x, commanded in zip(positions, speeds):
+                pose = make_pose2d(x, 0.0, 0.0)
+                subgoal = straight_line_subgoal((x, 0.0), goal, commanded, 0.5, 2.5, 1.5)
+                unit(
+                    robot_pose=pose,
+                    goal_in_robot_frame=in_robot_frame(x, goal),
+                    subgoal_in_robot_frame=in_robot_frame(x, subgoal),
+                )
+            return total_reward(rf)
+
+        cruise = [speed] * len(positions)
+        assert drive(True, cruise) == pytest.approx(0.0)
+        assert drive(False, cruise) == pytest.approx(0.3 * 2.0)
+
+        accel = [0.4] + [0.5] * (len(positions) - 1)
+        assert drive(True, accel) == pytest.approx(-0.4 * 0.15)
